# デプロイツール（FTP-Deploy-Action）が同期管理に使う状態ファイルを公開しない。
# 中身はファイル名とハッシュの一覧で、機密ではないがサイト構成が丸見えになるため塞ぐ。
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# HTMLはキャッシュさせない（スマホで古いページが残るのを防ぐ）。CSS/JS/画像は ?v= で制御
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>